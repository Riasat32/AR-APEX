# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Next.js / Vite compatible)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ar-store-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ar-store-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ar-store-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Vite compatible aliases
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="ar-store-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ar-store-app"
VITE_FIREBASE_STORAGE_BUCKET="ar-store-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Admin Configuration
ADMIN_EMAIL="admin@arstore.com"

